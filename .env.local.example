# ============================================
# DESARROLLO LOCAL - Copiar a .env.local
# ============================================
# Este archivo es para desarrollo local
# Cópialo como .env.local y úsalo en tu máquina

# Google OAuth
VITE_GOOGLE_CLIENT_ID=521088611438-g6te96b8g58i4nts0mbmk2up9i2ob41l.apps.googleusercontent.com

# Backend API - DESARROLLO LOCAL
# Apunta a tu backend local en http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

# ============================================
# PRODUCCIÓN - Netlify Environment Variables
# ============================================
# En Netlify NO uses este archivo, agrega las variables así:
# 
# 1. Ve a: Netlify Dashboard → Site settings → Build & deploy → Environment
# 2. Agrega estas variables:
#
# VITE_API_BASE_URL = https://api-tuapp.render.com/api
# VITE_GOOGLE_CLIENT_ID = 521088611438-g6te96b8g58i4nts0mbmk2up9i2ob41l.apps.googleusercontent.com
#
# NO COMMITS de .env.local a GitHub (ya está en .gitignore)
